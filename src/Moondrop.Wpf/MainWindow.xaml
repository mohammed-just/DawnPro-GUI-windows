<Window x:Class="Moondrop.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Moondrop.Wpf"
        Title="Moondrop Dawn Pro"
        Height="780" Width="1180" MinHeight="620" MinWidth="640"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid>
        <Grid x:Name="ShellGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavigationColumn" Width="176"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="72"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="16,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" CornerRadius="8"
                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                VerticalAlignment="Center">
                            <TextBlock Text="M" Foreground="White" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource WideOnlyStackPanelStyle}">
                            <TextBlock Text="MOONDROP" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="Audio control" Style="{StaticResource CaptionTextStyle}"/>
                        </StackPanel>
                    </Grid>

                    <ListBox Grid.Row="1"
                             Style="{StaticResource NavListStyle}"
                             ItemContainerStyle="{StaticResource NavItemStyle}"
                             SelectedValuePath="Tag"
                             SelectedValue="{Binding SelectedPage, Mode=TwoWay}">
                        <ListBoxItem Tag="{x:Static local:ShellPage.Eq}" ToolTip="EQ" AutomationProperties.Name="EQ">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="≋" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="EQ" Style="{StaticResource NavLabelStyle}"/>
                            </Grid>
                        </ListBoxItem>
                        <ListBoxItem Tag="{x:Static local:ShellPage.Device}" ToolTip="Device" AutomationProperties.Name="Device">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="◇" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Device" Style="{StaticResource NavLabelStyle}"/>
                            </Grid>
                        </ListBoxItem>
                        <ListBoxItem Tag="{x:Static local:ShellPage.Presets}" ToolTip="Presets" AutomationProperties.Name="Presets">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="☆" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Presets" Style="{StaticResource NavLabelStyle}"/>
                            </Grid>
                        </ListBoxItem>
                        <ListBoxItem Tag="{x:Static local:ShellPage.Settings}" ToolTip="Settings" AutomationProperties.Name="Settings">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="⚙" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Settings" Style="{StaticResource NavLabelStyle}"/>
                            </Grid>
                        </ListBoxItem>
                        <ListBoxItem Tag="{x:Static local:ShellPage.About}" ToolTip="About" AutomationProperties.Name="About">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="i" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="About" Style="{StaticResource NavLabelStyle}"/>
                            </Grid>
                        </ListBoxItem>
                    </ListBox>

                     <Border Grid.Row="2" Margin="10,8,10,14" Style="{StaticResource StatusPillStyle}"
                             ToolTip="{Binding ConnectionState}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentFillColorDefaultBrush}"
                                     VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding ConnectionState}" Style="{StaticResource NavLabelStyle}"
                                       TextTrimming="CharacterEllipsis" Margin="7,0,0,0"/>
                        </Grid>
                     </Border>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly">
                <StackPanel>
                    <Border x:Name="StatusBanner" Style="{StaticResource BannerBorderStyle}"
                            Margin="0,0,0,12"
                            Visibility="{Binding Banner.IsVisible, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="!" FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                       Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Banner.Title}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Banner.Message}" Style="{StaticResource CaptionTextStyle}"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="Dismiss" Command="{Binding Banner.DismissCommand}" Margin="12,0,0,0"/>
                        </Grid>
                    </Border>
                <Grid x:Name="ContentGrid" Margin="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="WorkspaceColumn" Width="*"/>
                        <ColumnDefinition x:Name="DeviceColumn" Width="280"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid x:Name="WorkspaceHost" Grid.Row="0" Grid.Column="0">
                        <StackPanel Visibility="{Binding SelectedPage, Converter={StaticResource ShellPageVisibility}, ConverterParameter=Eq}">
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Parametric EQ" Style="{StaticResource PageTitleTextStyle}"/>
                                    <TextBlock Text="Shape the response locally, then explicitly apply or save it."
                                               Style="{StaticResource CaptionTextStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                            Visibility="{Binding IsPro2, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Active EQ" Style="{StaticResource FieldLabelTextStyle}"/>
                                         <ComboBox Width="82"
                                                   ItemsSource="{Binding Source={x:Static local:MainViewModel.EqIndexes}}"
                                                   SelectedItem="{Binding ActiveEq}"
                                                   AutomationProperties.Name="Active EQ"/>
                                    </StackPanel>
                                    <Button Content="Apply" Command="{Binding ApplyActiveEqCommand}"
                                            AutomationProperties.Name="Apply active EQ"
                                            Style="{StaticResource PrimaryActionButtonStyle}" VerticalAlignment="Bottom"/>
                                    <Button Content="Refresh" Command="{Binding RefreshCommand}"
                                            AutomationProperties.Name="Refresh device (read only, no save)"
                                            Style="{StaticResource CompactActionButtonStyle}" VerticalAlignment="Bottom" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Border x:Name="GraphCard" Height="356" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,18"
                                    Visibility="{Binding IsPro2, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Margin="2,0,2,8">
                                        <TextBlock Text="Combined response" Style="{StaticResource SectionTitleTextStyle}"/>
                                        <TextBlock Text="Drag a marker for frequency/gain · Scroll for Q · Keyboard supported"
                                                   Style="{StaticResource NarrowHiddenCaptionStyle}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <local:EqGraph x:Name="EqGraphControl" Grid.Row="1"
                                                   Bands="{Binding Bands}"
                                                   PreGain="{Binding PreGain}"
                                                   SelectedBandIndex="{Binding SelectedBandIndex, Mode=TwoWay}"
                                                   ToolTip="Drag a numbered marker to change frequency and gain. Scroll over the graph to adjust Q. Use Ctrl+Left/Right to select bands."/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,18"
                                    Visibility="{Binding IsLegacy, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="Parametric EQ is not exposed by this device" Style="{StaticResource SectionTitleTextStyle}"/>
                                    <TextBlock Text="Use the Device page for the existing volume, gain, LED, and filter controls."
                                               Style="{StaticResource CaptionTextStyle}" Margin="0,6,0,12"/>
                                    <Button Content="Open Device" Click="OpenDevicePage" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,0,0,8" Visibility="{Binding IsPro2, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Bands" Style="{StaticResource SectionTitleTextStyle}"/>
                                <TextBlock Text="Select a numbered card or graph marker to edit it."
                                           Style="{StaticResource NarrowHiddenCaptionStyle}" HorizontalAlignment="Right"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Bands}"
                                          Visibility="{Binding IsPro2, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource BandCardBorderStyle}">
                                            <StackPanel>
                                                 <Button Style="{StaticResource BandSelectButtonStyle}"
                                                         Click="BandCardSelected"
                                                         Tag="{Binding Index}"
                                                         ToolTip="Select this band"
                                                         AutomationProperties.Name="{Binding DisplayIndex, StringFormat=Select band {0}}">
                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="30" Height="30" CornerRadius="15"
                                                                BorderThickness="2"
                                                                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}">
                                                            <TextBlock Text="{Binding DisplayIndex}" FontWeight="Bold"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DisplayIndex, StringFormat=Band {0}}" FontWeight="SemiBold"
                                                                       TextWrapping="NoWrap"/>
                                                            <TextBlock Text="Selected" Style="{StaticResource CaptionTextStyle}"
                                                                       TextWrapping="NoWrap"
                                                                       Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}"/>
                                                        </StackPanel>
                                                         <CheckBox Grid.Column="2" IsChecked="{Binding Enabled}"
                                                                   VerticalAlignment="Center" ToolTip="Enable this band"
                                                                   AutomationProperties.Name="{Binding DisplayIndex, StringFormat=Band {0} enabled}"/>
                                                    </Grid>
                                                </Button>
                                                <TextBlock Text="Filter" Style="{StaticResource FieldLabelTextStyle}"/>
                                                 <ComboBox SelectedItem="{Binding FilterType}"
                                                           ItemsSource="{Binding Source={x:Static local:MainViewModel.FilterTypes}}"
                                                           AutomationProperties.Name="{Binding DisplayIndex, StringFormat=Band {0} filter}"
                                                           Margin="0,0,0,8"/>
                                                <UniformGrid Columns="3">
                                                    <StackPanel Margin="0,0,6,0">
                                                        <TextBlock Text="Hz" Style="{StaticResource FieldLabelTextStyle}"/>
                                                         <TextBox Text="{Binding Frequency, UpdateSourceTrigger=PropertyChanged}"
                                                                  AutomationProperties.Name="{Binding DisplayIndex, StringFormat=Band {0} frequency in hertz}"/>
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,6,0">
                                                        <TextBlock Text="dB" Style="{StaticResource FieldLabelTextStyle}"/>
                                                         <TextBox Text="{Binding Gain, UpdateSourceTrigger=PropertyChanged, StringFormat=F1}"
                                                                  AutomationProperties.Name="{Binding DisplayIndex, StringFormat=Band {0} gain in decibels}"/>
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Text="Q" Style="{StaticResource FieldLabelTextStyle}"/>
                                                         <TextBox Text="{Binding Q, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"
                                                                  AutomationProperties.Name="{Binding DisplayIndex, StringFormat=Band {0} Q}"/>
                                                    </StackPanel>
                                                </UniformGrid>
                                                <Button Content="Apply band" Command="{Binding ApplyCommand}"
                                                        AutomationProperties.Name="{Binding DisplayIndex, StringFormat=Apply band {0}}"
                                                        HorizontalAlignment="Right" Margin="0,10,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Visibility="{Binding SelectedPage, Converter={StaticResource ShellPageVisibility}, ConverterParameter=Device}">
                            <TextBlock Text="Device" Style="{StaticResource PageTitleTextStyle}"/>
                            <TextBlock Text="Controls reported and supported by the connected device."
                                       Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,16"/>

                            <Border Style="{StaticResource CardBorderStyle}"
                                    Visibility="{Binding IsPro2, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="DAWN PRO2 gains" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,12"/>
                                    <UniformGrid Columns="2">
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="Pre gain (dB)" Style="{StaticResource FieldLabelTextStyle}"/>
                                            <DockPanel>
                                                <Button Content="Apply" DockPanel.Dock="Right" Command="{Binding ApplyPreGainCommand}" Margin="8,0,0,0"
                                                        AutomationProperties.Name="Apply pre gain"/>
                                                <TextBox Text="{Binding PreGain, UpdateSourceTrigger=PropertyChanged, StringFormat=F1}"
                                                         AutomationProperties.Name="Pre gain in decibels"/>
                                            </DockPanel>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Global gain (dB)" Style="{StaticResource FieldLabelTextStyle}"/>
                                            <DockPanel>
                                                <Button Content="Apply" DockPanel.Dock="Right" Command="{Binding ApplyGlobalGainCommand}" Margin="8,0,0,0"
                                                        AutomationProperties.Name="Apply global gain"/>
                                                <TextBox Text="{Binding GlobalGain, UpdateSourceTrigger=PropertyChanged, StringFormat=F1}"
                                                         AutomationProperties.Name="Global gain in decibels"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}"
                                    Visibility="{Binding IsLegacy, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="Dawn Pro controls" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,12"/>
                                    <TextBlock Text="Volume" Style="{StaticResource FieldLabelTextStyle}"/>
                                    <Slider Minimum="0" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True"
                                            AutomationProperties.Name="Legacy volume"
                                            Value="{Binding LegacyVolume, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="{Binding LegacyVolume}" HorizontalAlignment="Right" Margin="0,0,0,8"/>
                                    <TextBlock Text="Gain" Style="{StaticResource FieldLabelTextStyle}"/>
                                    <ComboBox ItemsSource="{Binding Source={x:Static local:MainViewModel.LegacyGains}}"
                                              AutomationProperties.Name="Legacy gain"
                                              SelectedItem="{Binding LegacyGain}" Margin="0,0,0,8"/>
                                    <TextBlock Text="LED" Style="{StaticResource FieldLabelTextStyle}"/>
                                    <ComboBox ItemsSource="{Binding Source={x:Static local:MainViewModel.LegacyLeds}}"
                                              AutomationProperties.Name="Legacy LED"
                                              SelectedItem="{Binding LegacyLed}" Margin="0,0,0,8"/>
                                    <TextBlock Text="Filter" Style="{StaticResource FieldLabelTextStyle}"/>
                                    <ComboBox ItemsSource="{Binding Source={x:Static local:MainViewModel.LegacyFilters}}"
                                              AutomationProperties.Name="Legacy filter"
                                              SelectedItem="{Binding LegacyFilter}" Margin="0,0,0,12"/>
                                    <Button Content="Apply legacy settings" Command="{Binding ApplyLegacyCommand}" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Visibility="{Binding SelectedPage, Converter={StaticResource ShellPageVisibility}, ConverterParameter=Presets}">
                             <TextBlock Text="Presets" Style="{StaticResource PageTitleTextStyle}"/>
                             <TextBlock Text="Import EQ text files and explicitly synchronize or persist them."
                                        Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,16"
                                        Visibility="{Binding IsPro2, Converter={StaticResource BoolToVisibility}}"/>
                             <TextBlock Text="EQ preset import and flash workflows are not available on the original Dawn Pro."
                                        Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,16"
                                        Visibility="{Binding IsLegacy, Converter={StaticResource BoolToVisibility}}"/>
                             <Border Style="{StaticResource CardBorderStyle}"
                                     Visibility="{Binding IsPro2, Converter={StaticResource BoolToVisibility}}">
                                 <StackPanel>
                                    <TextBlock Text="EQ import" Style="{StaticResource SectionTitleTextStyle}"/>
                                    <TextBlock Text="Import previews a confirmation before any device writes. Import never saves to flash automatically."
                                               Style="{StaticResource CaptionTextStyle}" Margin="0,6,0,14"/>
                                    <WrapPanel>
                                        <Button Content="Import EQ…" Command="{Binding ImportEqCommand}"
                                                Style="{StaticResource CompactActionButtonStyle}"/>
                                        <Button Content="Apply all" Command="{Binding ApplyAllCommand}"
                                                Style="{StaticResource CompactActionButtonStyle}"/>
                                        <Button Content="Save EQ to flash" Command="{Binding SaveEqCommand}"
                                                Style="{StaticResource CompactActionButtonStyle}"/>
                                    </WrapPanel>
                                 </StackPanel>
                             </Border>
                             <Border Style="{StaticResource CardBorderStyle}"
                                     Visibility="{Binding IsLegacy, Converter={StaticResource BoolToVisibility}}">
                                 <StackPanel>
                                     <TextBlock Text="Original Dawn Pro" Style="{StaticResource SectionTitleTextStyle}"/>
                                     <TextBlock Text="Use the Device page for the supported volume, gain, LED, and filter controls."
                                                Style="{StaticResource CaptionTextStyle}" Margin="0,6,0,14"/>
                                     <Button Content="Open Device" Click="OpenDevicePage" HorizontalAlignment="Left"/>
                                 </StackPanel>
                             </Border>
                         </StackPanel>

                        <StackPanel Visibility="{Binding SelectedPage, Converter={StaticResource ShellPageVisibility}, ConverterParameter=Settings}">
                            <TextBlock Text="Settings" Style="{StaticResource PageTitleTextStyle}"/>
                            <TextBlock Text="Appearance and existing local defaults."
                                       Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,16"/>
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="Appearance" Style="{StaticResource SectionTitleTextStyle}"/>
                                    <TextBlock Text="Theme" Style="{StaticResource FieldLabelTextStyle}" Margin="0,12,0,4"/>
                                    <ComboBox Width="180" HorizontalAlignment="Left"
                                              AutomationProperties.Name="Theme"
                                              SelectedValue="{Binding ThemeSelection}"
                                              SelectedValuePath="Content"
                                              SelectionChanged="ThemeSelectionChanged">
                                        <ComboBoxItem Content="System"/>
                                        <ComboBoxItem Content="Light"/>
                                        <ComboBoxItem Content="Dark"/>
                                    </ComboBox>
                                    <Separator Margin="0,16"/>
                                    <TextBlock Text="Local defaults" Style="{StaticResource SectionTitleTextStyle}"/>
                                    <TextBlock Text="Save the current supported values to the existing configuration file."
                                               Style="{StaticResource CaptionTextStyle}" Margin="0,6,0,12"/>
                                    <Button Content="Save settings" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Visibility="{Binding SelectedPage, Converter={StaticResource ShellPageVisibility}, ConverterParameter=About}">
                            <TextBlock Text="About" Style="{StaticResource PageTitleTextStyle}"/>
                            <TextBlock Text="Native Windows control utility for supported Moondrop Dawn Pro devices."
                                       Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,16"/>
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="Moondrop Dawn Pro" Style="{StaticResource SectionTitleTextStyle}"/>
                                    <TextBlock Text=".NET 10 · WPF · Official Fluent theme"
                                               Style="{StaticResource CaptionTextStyle}" Margin="0,6,0,14"/>
                                    <Button Content="Open diagnostics" Command="{Binding ShowDiagnosticsCommand}" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Border x:Name="DevicePanel" Grid.Row="0" Grid.Column="1"
                            Margin="16,0,0,0" Style="{StaticResource CardBorderStyle}"
                            VerticalAlignment="Top">
                        <StackPanel>
                            <StackPanel>
                                <TextBlock Text="Device" Style="{StaticResource SectionTitleTextStyle}"/>
                                <Border Style="{StaticResource StatusPillStyle}" HorizontalAlignment="Left" Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Margin="0,0,6,0"
                                                 Fill="{DynamicResource AccentFillColorDefaultBrush}"/>
                                        <TextBlock Text="{Binding ConnectionState}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <Viewbox Width="120" Height="86" Margin="0,16,0,10" Stretch="Uniform">
                                <Grid Width="130" Height="76">
                                    <Border Width="92" Height="48" CornerRadius="15"
                                            BorderBrush="{DynamicResource TextFillColorSecondaryBrush}"
                                            BorderThickness="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Grid>
                                            <Ellipse Width="12" Height="12" Stroke="{DynamicResource AccentFillColorDefaultBrush}"
                                                     StrokeThickness="3" HorizontalAlignment="Left" Margin="14,0,0,0"/>
                                            <Line X1="58" Y1="13" X2="58" Y2="35"
                                                  Stroke="{DynamicResource TextFillColorSecondaryBrush}" StrokeThickness="3"/>
                                            <Line X1="68" Y1="13" X2="68" Y2="35"
                                                  Stroke="{DynamicResource TextFillColorSecondaryBrush}" StrokeThickness="3"/>
                                        </Grid>
                                    </Border>
                                    <Line X1="0" Y1="38" X2="19" Y2="38"
                                          Stroke="{DynamicResource TextFillColorSecondaryBrush}" StrokeThickness="4"/>
                                    <Line X1="111" Y1="38" X2="130" Y2="38"
                                          Stroke="{DynamicResource TextFillColorSecondaryBrush}" StrokeThickness="4"/>
                                </Grid>
                            </Viewbox>
                            <TextBlock Text="{Binding SelectedDevice}" FontSize="18" FontWeight="SemiBold"
                                       TextAlignment="Center" TextWrapping="Wrap"/>
                            <Grid Margin="0,12,0,14" Visibility="{Binding IsPro2, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Firmware" Style="{StaticResource CaptionTextStyle}"/>
                                <TextBlock Grid.Column="1" Text="{Binding FirmwareVersion}" FontWeight="SemiBold"/>
                            </Grid>
                            <Separator Margin="0,0,0,14"/>
                            <TextBlock Text="Actions" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,10"/>
                            <WrapPanel>
                                <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource CompactActionButtonStyle}"/>
                                <Button Content="Diagnostics" Command="{Binding ShowDiagnosticsCommand}" Style="{StaticResource CompactActionButtonStyle}"/>
                                <Button Content="Apply all" Command="{Binding ApplyAllCommand}" Style="{StaticResource CompactActionButtonStyle}"
                                        Visibility="{Binding IsPro2, Converter={StaticResource BoolToVisibility}}"/>
                                <Button Content="Enable coefficients" Command="{Binding EnableCoefficientsCommand}" Style="{StaticResource CompactActionButtonStyle}"
                                        Visibility="{Binding IsPro2, Converter={StaticResource BoolToVisibility}}"/>
                                <Button Content="Save EQ" Command="{Binding SaveEqCommand}" Style="{StaticResource CompactActionButtonStyle}"
                                        Visibility="{Binding IsPro2, Converter={StaticResource BoolToVisibility}}"/>
                                <Button Content="Save gains" Command="{Binding SaveGainsCommand}" Style="{StaticResource CompactActionButtonStyle}"
                                        Visibility="{Binding IsPro2, Converter={StaticResource BoolToVisibility}}"/>
                                <Button Content="Save settings" Command="{Binding SaveSettingsCommand}" Style="{StaticResource CompactActionButtonStyle}"/>
                            </WrapPanel>
                            <TextBlock Text="Apply changes explicitly. Flash saves remain separate."
                                       Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0"
                                       Visibility="{Binding IsPro2, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,16,0,0"
                            Padding="10,7" CornerRadius="6"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                        <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis"/>
                    </Border>
                </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="ConfirmationOverlay"
              Panel.ZIndex="30"
              Background="#99000000"
              Visibility="{Binding Dialog.IsOpen, Converter={StaticResource BoolToVisibility}}"
              PreviewKeyDown="ConfirmationOverlayPreviewKeyDown">
            <local:AccessibleDialog x:Name="ConfirmationDialog"
                    Width="440" MaxWidth="560" Margin="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Style="{StaticResource CardBorderStyle}"
                    FocusManager.IsFocusScope="True"
                    KeyboardNavigation.TabNavigation="Cycle"
                    KeyboardNavigation.ControlTabNavigation="Cycle"
                    KeyboardNavigation.DirectionalNavigation="Contained"
                    AutomationProperties.Name="{Binding Dialog.Title}"
                    AutomationProperties.HelpText="{Binding Dialog.Message}"
                    AutomationProperties.LiveSetting="Assertive"
                    AutomationProperties.IsDialog="True">
                <StackPanel>
                    <TextBlock Text="{Binding Dialog.Title}" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Dialog.Message}" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,10,0,20"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="DialogCancelButton" Content="Cancel" Command="{Binding Dialog.CancelCommand}" Margin="0,0,8,0" IsCancel="True"/>
                        <Button x:Name="DialogPrimaryButton" Content="{Binding Dialog.PrimaryText}" Command="{Binding Dialog.ConfirmCommand}"
                                Style="{StaticResource PrimaryActionButtonStyle}" IsDefault="True"/>
                    </StackPanel>
                </StackPanel>
            </local:AccessibleDialog>
        </Grid>
    </Grid>
</Window>
