<Window x:Class="Moondrop.Wpf.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Moondrop.Wpf" Title="Moondrop" Icon="Assets/device-logo.ico" Width="1180" Height="780" MinWidth="640" MinHeight="620"
 FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale"
 Background="{DynamicResource ApplicationBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
 PreviewKeyDown="WindowKeyDown" PreviewMouseLeftButtonDown="StartEditGesture" PreviewMouseLeftButtonUp="EndEditGesture">
 <Window.Resources>
  <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="MinWidth" Value="64"/><Style.Triggers><Trigger Property="Validation.HasError" Value="True"><Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}"/></Trigger></Style.Triggers></Style>
 </Window.Resources>
 <Grid>
 <Grid x:Name="ShellGrid"><Grid.ColumnDefinitions><ColumnDefinition x:Name="NavigationColumn" Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
   <DockPanel Margin="8,20,8,12">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,26">
     <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center"><TextBlock Text="M" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <TextBlock x:Name="BrandLabel" Text="MOONDROP" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
    </StackPanel>
    <ListBox Style="{StaticResource NavListStyle}" ItemContainerStyle="{StaticResource NavItemStyle}" SelectedValuePath="Tag" SelectedValue="{Binding SelectedPage, Mode=TwoWay}">
     <ListBoxItem Tag="{x:Static local:ShellPage.Eq}" ToolTip="Equalizer" AutomationProperties.Name="Equalizer"><StackPanel Orientation="Horizontal"><TextBlock Text="≋" FontSize="22" Width="24"/><TextBlock Text="Equalizer" Style="{StaticResource NavLabelStyle}"/></StackPanel></ListBoxItem>
     <ListBoxItem Tag="{x:Static local:ShellPage.Presets}" ToolTip="Presets" AutomationProperties.Name="Presets"><StackPanel Orientation="Horizontal"><TextBlock Text="☆" FontSize="20" Width="24"/><TextBlock Text="Presets" Style="{StaticResource NavLabelStyle}"/></StackPanel></ListBoxItem>
     <ListBoxItem Tag="{x:Static local:ShellPage.Settings}" ToolTip="Settings" AutomationProperties.Name="Settings"><StackPanel Orientation="Horizontal"><TextBlock Text="⚙" FontSize="20" Width="24"/><TextBlock Text="Settings" Style="{StaticResource NavLabelStyle}"/></StackPanel></ListBoxItem>
    </ListBox>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="22,8,22,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid Height="38" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" Margin="0,0,10,0"><Ellipse.Style><Style TargetType="Ellipse"><Style.Triggers><DataTrigger Binding="{Binding IsHardwareConnected}" Value="False"><Setter Property="Opacity" Value="0.35"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock Text="{Binding DeviceSummary}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding FirmwareVersion, StringFormat=Firmware {0}}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Margin="12,0"/><Button Content="↻" Command="{Binding RefreshCommand}" Padding="8,3" ToolTip="Refresh device values; keep local edits" AutomationProperties.Name="Refresh device"/></StackPanel>
   </Grid>
   <Border x:Name="StatusBanner" Grid.Row="1" Style="{StaticResource BannerBorderStyle}" Margin="0,0,0,8" Visibility="{Binding Banner.IsVisible, Converter={StaticResource BoolToVisibility}}"><DockPanel><Button DockPanel.Dock="Right" Content="Dismiss" Command="{Binding Banner.DismissCommand}"/><StackPanel><TextBlock Text="{Binding Banner.Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Banner.Message}" TextWrapping="Wrap"/></StackPanel></DockPanel></Border>
   <Grid Grid.Row="2">
    <Grid Visibility="{Binding SelectedPage, Converter={StaticResource ShellPageVisibility}, ConverterParameter=Eq}"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <ScrollViewer x:Name="EqPageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
      <StackPanel>
       <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Equalizer" Style="{StaticResource PageTitleTextStyle}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Undo" Command="{Binding UndoCommand}" Padding="10,4" Margin="0,0,6,0"/><Button Content="Redo" Command="{Binding RedoCommand}" Padding="10,4" Margin="0,0,6,0"/><Button Content="Reset EQ" Command="{Binding ResetEqCommand}" Padding="10,4" ToolTip="Reset EQ filters and pre-gain. Global gain is kept."/></StackPanel></Grid>
       <StackPanel IsEnabled="{Binding IsEditable}" Visibility="{Binding IsPro2, Converter={StaticResource BoolToVisibility}}">
        <WrapPanel Margin="0,0,0,10">
         <TextBlock Text="Preset" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox Width="180" ItemsSource="{Binding PresetOptions}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding EditingPresetId, Mode=TwoWay}" AutomationProperties.Name="Preset"/>
         <TextBlock Text="Edited" Foreground="{DynamicResource AccentFillColorDefaultBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0" Visibility="{Binding IsPresetEdited, Converter={StaticResource BoolToVisibility}}"/>
         <Button Content="Save as preset" Command="{Binding SaveLocalCommand}" Margin="8,0,16,0" Padding="10,4"/>
         <StackPanel Orientation="Horizontal"><TextBlock Text="Target" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox Width="150" ItemsSource="{Binding ReferenceOptions}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding ReferenceId, Mode=TwoWay}" AutomationProperties.Name="Target" ToolTip="Compare an EQ tuning curve from a local preset. Acoustic target matching requires headphone measurements."/>
         <Button Content="＋" Command="{Binding ImportTargetCommand}" Padding="6,3" Margin="6,0,0,0" ToolTip="Import EQ target" AutomationProperties.Name="Import target"/></StackPanel>
         <CheckBox Content="Show EQ curve" IsChecked="{Binding PreviewEq}" Style="{StaticResource SwitchStyle}" MinHeight="34" Margin="16,0,0,0" ToolTip="Show or hide the local EQ curve. This does not bypass processing on the device."/>
        </WrapPanel>
        <Border x:Name="GraphCard" Height="222" Style="{StaticResource CompactCardBorderStyle}" Padding="12,8">
         <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid Margin="4,0,4,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Frequency response" Style="{StaticResource SectionTitleTextStyle}"/>
           <WrapPanel Grid.Column="1" VerticalAlignment="Center"><Line X1="0" X2="20" Stroke="{DynamicResource AccentFillColorDefaultBrush}" StrokeThickness="2" Width="20" VerticalAlignment="Center"/><TextBlock Text="Combined" FontSize="11" Margin="6,0,12,0"/><StackPanel Orientation="Horizontal" Visibility="{Binding IndividualCurves, Converter={StaticResource BoolToVisibility}}"><Line X1="0" X2="20" Stroke="{DynamicResource AccentFillColorDefaultBrush}" StrokeThickness="1" StrokeDashArray="4 3" Width="20" VerticalAlignment="Center"/><TextBlock Text="Selected band" FontSize="11" Margin="6,0,12,0"/></StackPanel><Line X1="0" X2="20" Stroke="{DynamicResource TargetBrush}" StrokeThickness="2" StrokeDashArray="1 2" Width="20" VerticalAlignment="Center"/><TextBlock Text="Target" FontSize="11" Margin="6,0,0,0"/></WrapPanel>
          </Grid>
          <local:EqGraph x:Name="EqGraphControl" Grid.Row="1" Bands="{Binding Bands}" PreGain="0" SelectedBandIndex="{Binding SelectedBandIndex, Mode=TwoWay}" IndividualCurves="{Binding IndividualCurves}" ReferenceBands="{Binding ReferenceBands}" ShowReference="{Binding ShowReferenceCurve}" PreviewEnabled="{Binding PreviewEq}" AutomationProperties.Name="EQ response graph" AutomationProperties.HelpText="EQ filter shapes in dB versus frequency in Hz. Gains are shown separately. Arrow keys edit frequency and gain; Page Up/Down edit Q; Ctrl arrows select bands." ToolTip="EQ filter shapes only; pre-gain and global gain are shown separately. Drag a marker to edit frequency and gain; scroll to adjust Q."/>
         </Grid>
        </Border>
        <Grid Margin="0,8,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <StackPanel Margin="0,0,10,0"><TextBlock Text="Pre-gain · dB" Style="{StaticResource CaptionTextStyle}"/><TextBox AutomationProperties.Name="Pre gain"><TextBox.Text><Binding Path="PreGain" UpdateSourceTrigger="LostFocus" NotifyOnValidationError="True" Converter="{StaticResource GainText}"><Binding.ValidationRules><local:NumericRule Minimum="-18" Maximum="12"/></Binding.ValidationRules></Binding></TextBox.Text></TextBox></StackPanel>
         <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Global gain · dB" Style="{StaticResource CaptionTextStyle}"/><TextBox AutomationProperties.Name="Global gain"><TextBox.Text><Binding Path="GlobalGain" UpdateSourceTrigger="LostFocus" NotifyOnValidationError="True" Converter="{StaticResource GainText}"><Binding.ValidationRules><local:NumericRule Minimum="-18" Maximum="12"/></Binding.ValidationRules></Binding></TextBox.Text></TextBox></StackPanel>
         <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0"><WrapPanel><TextBlock Text="Headroom  " Foreground="{DynamicResource TextFillColorSecondaryBrush}"/><TextBlock Text="{Binding HeadroomValue}" FontWeight="SemiBold" ToolTip="Estimated EQ headroom includes pre-gain and excludes global gain."><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/><Style.Triggers><DataTrigger Binding="{Binding HasHeadroom}" Value="False"><Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></WrapPanel><WrapPanel><TextBlock Text="Recommended pre-gain: " Style="{StaticResource CaptionTextStyle}"/><TextBlock Text="{Binding RecommendedPreGainText}" Style="{StaticResource CaptionTextStyle}"/><TextBlock Text="{Binding AutoProtectionLabel}" Style="{StaticResource CaptionTextStyle}" Margin="12,0,0,0"/></WrapPanel></StackPanel>
        </Grid>
        <Grid x:Name="BandEditorGrid"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition x:Name="EditorColumn" Width="260"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <Border Style="{StaticResource CompactCardBorderStyle}" Padding="0" Margin="0,0,12,0"><StackPanel><DockPanel Margin="14,9"><TextBlock Text="Select a row to edit" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource CaptionTextStyle}"/><TextBlock Text="EQ bands" FontWeight="SemiBold"/></DockPanel>
          <DataGrid x:Name="BandTable" ItemsSource="{Binding Bands}" SelectedIndex="{Binding SelectedBandIndex, Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" CanUserResizeRows="False" HeadersVisibility="Column" RowHeight="25" ColumnHeaderHeight="26" Height="228" SelectionMode="Single" SelectionUnit="FullRow" EnableRowVirtualization="False" AutomationProperties.Name="Eight band draft table" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
           <DataGrid.Columns>
            <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="40"/><DataGridTextColumn Header="#" Binding="{Binding DisplayIndex}" IsReadOnly="True" Width="28"/>
            <DataGridComboBoxColumn Header="Filter" ItemsSource="{x:Static local:MainViewModel.FilterTypes}" SelectedItemBinding="{Binding FilterType}" Width="*"/>
            <DataGridTextColumn Header="Hz" Width="78"><DataGridTextColumn.Binding><Binding Path="Frequency" Converter="{StaticResource FrequencyText}" UpdateSourceTrigger="LostFocus" NotifyOnValidationError="True"><Binding.ValidationRules><local:NumericRule Minimum="20" Maximum="20000" Integer="True"/></Binding.ValidationRules></Binding></DataGridTextColumn.Binding></DataGridTextColumn>
            <DataGridTextColumn Header="dB" Width="68"><DataGridTextColumn.Binding><Binding Path="Gain" Converter="{StaticResource GainText}" ConverterParameter="signed" UpdateSourceTrigger="LostFocus" NotifyOnValidationError="True"><Binding.ValidationRules><local:NumericRule Minimum="-18" Maximum="12"/></Binding.ValidationRules></Binding></DataGridTextColumn.Binding></DataGridTextColumn>
            <DataGridTextColumn Header="Q" Width="58"><DataGridTextColumn.Binding><Binding Path="Q" Converter="{StaticResource QText}" UpdateSourceTrigger="LostFocus" NotifyOnValidationError="True"><Binding.ValidationRules><local:NumericRule Minimum="0.00390625" Maximum="127"/></Binding.ValidationRules></Binding></DataGridTextColumn.Binding></DataGridTextColumn>
           </DataGrid.Columns>
          </DataGrid>
         </StackPanel></Border>
         <Border x:Name="SelectedBandEditor" Grid.Column="1" Style="{StaticResource CompactCardBorderStyle}" Padding="14,10" DataContext="{Binding SelectedBand}" VerticalAlignment="Top">
          <StackPanel>
           <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding DisplayIndex, StringFormat=Band {0}}" FontWeight="SemiBold" VerticalAlignment="Center"/><CheckBox Grid.Column="1" IsChecked="{Binding Enabled}" Content="Enabled" Style="{StaticResource SwitchStyle}" MinHeight="24" AutomationProperties.Name="Selected band enabled"/></Grid>
           <ComboBox ItemsSource="{x:Static local:MainViewModel.FilterTypes}" SelectedItem="{Binding FilterType}" AutomationProperties.Name="Selected band type" Margin="0,0,0,8"/>
           <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="105"/></Grid.ColumnDefinitions><TextBlock Text="Frequency · Hz" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center"/><TextBox Grid.Column="1" AutomationProperties.Name="Selected band frequency"><TextBox.Text><Binding Path="Frequency" Converter="{StaticResource FrequencyText}" UpdateSourceTrigger="LostFocus" NotifyOnValidationError="True"><Binding.ValidationRules><local:NumericRule Minimum="20" Maximum="20000" Integer="True"/></Binding.ValidationRules></Binding></TextBox.Text></TextBox></Grid>
           <Slider Minimum="20" Maximum="20000" Value="{Binding Frequency}" AutomationProperties.Name="Selected band frequency slider" Margin="0,2,0,5"/>
           <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,8,0"><TextBlock Text="Gain · dB" Style="{StaticResource CaptionTextStyle}"/><TextBox AutomationProperties.Name="Selected band gain"><TextBox.Text><Binding Path="Gain" Converter="{StaticResource GainText}" UpdateSourceTrigger="LostFocus" NotifyOnValidationError="True"><Binding.ValidationRules><local:NumericRule Minimum="-18" Maximum="12"/></Binding.ValidationRules></Binding></TextBox.Text></TextBox></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock Text="Q" Style="{StaticResource CaptionTextStyle}"/><TextBox AutomationProperties.Name="Selected band Q"><TextBox.Text><Binding Path="Q" Converter="{StaticResource QText}" UpdateSourceTrigger="LostFocus" NotifyOnValidationError="True"><Binding.ValidationRules><local:NumericRule Minimum="0.00390625" Maximum="127"/></Binding.ValidationRules></Binding></TextBox.Text></TextBox></StackPanel>
           </Grid>
           <Slider Minimum="-18" Maximum="12" Value="{Binding Gain}" AutomationProperties.Name="Selected band gain slider" Margin="0,2,0,6"/>
           <Button Content="Reset band" Command="{Binding DataContext.ResetBandCommand, RelativeSource={RelativeSource AncestorType=Window}}" Padding="10,3" MinHeight="28" ToolTip="Reset this band only: disabled, peaking, 1,000 Hz, 0.0 dB, Q 1.00."/>
          </StackPanel>
         </Border>
        </Grid>

       </StackPanel>
       <Border Visibility="{Binding IsLegacy, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource CardBorderStyle}" IsEnabled="{Binding IsEditable}">
        <StackPanel><TextBlock Text="Original DAWN PRO" FontSize="20"/><TextBlock Text="Adjust your device controls, then apply changes when ready." TextWrapping="Wrap" Margin="0,8"/>
         <TextBlock Text="Volume"/><Slider Minimum="0" Maximum="60" Value="{Binding LegacyVolume}" AutomationProperties.Name="Legacy volume"/><TextBlock Text="{Binding LegacyVolume}"/>
         <TextBlock Text="Gain"/><ComboBox ItemsSource="{x:Static local:MainViewModel.LegacyGains}" SelectedItem="{Binding LegacyGain}" AutomationProperties.Name="Legacy gain" Margin="0,4,0,12"/>
         <TextBlock Text="LED"/><ComboBox ItemsSource="{x:Static local:MainViewModel.LegacyLeds}" SelectedItem="{Binding LegacyLed}" AutomationProperties.Name="Legacy LED" Margin="0,4,0,12"/>
         <TextBlock Text="Filter"/><ComboBox ItemsSource="{x:Static local:MainViewModel.LegacyFilters}" SelectedItem="{Binding LegacyFilter}" AutomationProperties.Name="Legacy filter" Margin="0,4,0,12"/>
        </StackPanel>
       </Border>

      </StackPanel>
     </ScrollViewer>
     <Border Grid.Row="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,10,0,0">
      <StackPanel><TextBlock Text="{Binding ValidationMessage}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding ValidationMessage}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
       <WrapPanel><StackPanel Width="315" Margin="0,0,14,0"><TextBlock Text="{Binding StateTitle}" FontWeight="SemiBold"/><TextBlock Text="{Binding StateDescription}" Style="{StaticResource CaptionTextStyle}"/></StackPanel>
        <WrapPanel VerticalAlignment="Center"><Button Content="Discard edits" Command="{Binding DiscardCommand}" Margin="0,0,6,0"/><Button Content="Apply changes" Command="{Binding ApplyAllCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,6,0" ToolTip="{Binding ApplyActionHint}" ToolTipService.ShowOnDisabled="True"/><Button Content="Save to device" Command="{Binding SaveEqCommand}" ToolTip="{Binding SaveActionHint}" ToolTipService.ShowOnDisabled="True"/></WrapPanel>
       </WrapPanel>
      </StackPanel>
     </Border>
    </Grid>
    <ScrollViewer Visibility="{Binding SelectedPage, Converter={StaticResource ShellPageVisibility}, ConverterParameter=Presets}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
     <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch"><TextBlock Text="Presets" Style="{StaticResource PageTitleTextStyle}"/><TextBlock Text="Your device EQ and personal presets, in one place." Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,20"/>
      <Border Style="{StaticResource CardBorderStyle}" Padding="22">
       <StackPanel><Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Preset library" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Open a preset to edit it. Apply changes from Equalizer." Style="{StaticResource CaptionTextStyle}" Margin="0,4,10,0"/></StackPanel><WrapPanel Grid.Column="1"><Button Content="Import" Command="{Binding ImportEqCommand}" Margin="0,0,8,0"/><Button Content="Export" Command="{Binding ExportPresetCommand}" Margin="0,0,8,0" ToolTip="Select a local preset to export" ToolTipService.ShowOnDisabled="True"/><Button Content="+ New preset" Command="{Binding NewPresetCommand}" Style="{StaticResource PrimaryButtonStyle}"/></WrapPanel></Grid>
        <StackPanel Visibility="{Binding IsHardwareConnected, Converter={StaticResource BoolToVisibility}}"><Border Style="{StaticResource CompactCardBorderStyle}" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" Background="{DynamicResource AccentSurfaceBrush}" Margin="0,0,0,12"><DockPanel><Button Content="Open" DockPanel.Dock="Right" Command="{Binding OpenObservedCommand}"/><StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding ActiveConfiguration}" FontWeight="SemiBold"/><TextBlock Text="Device EQ · Active" Style="{StaticResource CaptionTextStyle}" Margin="0,3,0,0"/></StackPanel></DockPanel></Border></StackPanel>
        <ListBox ItemsSource="{Binding LocalPresets}" SelectedItem="{Binding SelectedPreset}" ItemContainerStyle="{StaticResource PresetRowStyle}" Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}" BorderThickness="0" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Local presets" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
         <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Description}" Style="{StaticResource CaptionTextStyle}" Margin="0,3,0,0"/></StackPanel><Button Grid.Column="1" Content="Open" Click="PresetOpenClick" Margin="8,0"/><Menu Grid.Column="2" VerticalAlignment="Center" Background="Transparent"><MenuItem Header="⋯" AutomationProperties.Name="Preset actions"><MenuItem Header="Rename" Click="PresetRenameClick"/><MenuItem Header="Duplicate" Click="PresetDuplicateClick"/><MenuItem Header="Export" Click="PresetExportClick"/><Separator/><MenuItem Header="Delete locally" Click="PresetDeleteClick"/></MenuItem></Menu></Grid></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <Border Visibility="{Binding HasNoLocalPresets, Converter={StaticResource BoolToVisibility}}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="28" Margin="0,4,0,0"><StackPanel HorizontalAlignment="Center"><TextBlock Text="No local presets yet" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Import an EQ or create your first preset." Style="{StaticResource CaptionTextStyle}" Margin="0,6,0,14"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="Import EQ" Command="{Binding ImportEqCommand}" Margin="0,0,8,0"/><Button Content="New preset" Command="{Binding NewPresetCommand}"/></StackPanel></StackPanel></Border>
        <TextBlock Text="Imports Equalizer APO text and Moondrop preset files. Unsupported filters are explained before import." Style="{StaticResource CaptionTextStyle}" Margin="0,16,0,0"/>
       </StackPanel>
      </Border>
     </StackPanel>
    </ScrollViewer>
    <ScrollViewer Visibility="{Binding SelectedPage, Converter={StaticResource ShellPageVisibility}, ConverterParameter=Settings}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
     <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch"><TextBlock Text="Settings" Style="{StaticResource PageTitleTextStyle}"/><TextBlock Text="Appearance, behavior, and advanced options." Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,20"/>
      <Border Style="{StaticResource CardBorderStyle}" Padding="22"><StackPanel><UniformGrid x:Name="SettingsGroups" Columns="2"><Border Style="{StaticResource CardBorderStyle}" Background="{DynamicResource LayerFillColorDefaultBrush}" Margin="0,0,12,12" Padding="18,12"><StackPanel><TextBlock Text="Appearance" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,8"/><Grid Height="44"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions><TextBlock Text="Theme" VerticalAlignment="Center"/><ComboBox Grid.Column="1" SelectedValuePath="Content" SelectedValue="{Binding ThemeSelection, Mode=TwoWay}" AutomationProperties.Name="Theme"><ComboBoxItem Content="System"/><ComboBoxItem Content="Light"/><ComboBoxItem Content="Dark"/></ComboBox></Grid><Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,0"><CheckBox Content="Use system accent" IsChecked="{Binding SystemAccent, Mode=TwoWay}" Style="{StaticResource SwitchStyle}" AutomationProperties.Name="Use system accent" ToolTip="Use your Windows accent color."/></Border></StackPanel></Border><Border Style="{StaticResource CardBorderStyle}" Background="{DynamicResource LayerFillColorDefaultBrush}" Margin="0,0,12,12" Padding="18,12"><StackPanel><TextBlock Text="Behavior" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,8"/><Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"><CheckBox Content="Reconnect automatically" IsChecked="{Binding ReconnectAutomatically, Mode=TwoWay}" Style="{StaticResource SwitchStyle}" AutomationProperties.Name="Reconnect automatically" ToolTip="Reconnect when your DAC becomes available."/></Border><Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"><CheckBox Content="Confirm flash writes" IsChecked="{Binding ConfirmFlash, Mode=TwoWay}" Style="{StaticResource SwitchStyle}" AutomationProperties.Name="Confirm flash writes" ToolTip="Ask before saving permanently to device memory."/></Border><Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,0"><CheckBox Content="Remember last EQ" IsChecked="{Binding RememberEq, Mode=TwoWay}" Style="{StaticResource SwitchStyle}" AutomationProperties.Name="Remember last EQ" ToolTip="Restore your editing workspace on launch. Changes are applied only when you choose Apply."/></Border></StackPanel></Border><Border Style="{StaticResource CardBorderStyle}" Background="{DynamicResource LayerFillColorDefaultBrush}" Margin="0,0,12,12" Padding="18,12"><StackPanel><TextBlock Text="EQ" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,8"/><Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"><CheckBox Content="Auto preamp protection" IsChecked="{Binding AutoPreamp, Mode=TwoWay}" Style="{StaticResource SwitchStyle}" AutomationProperties.Name="Auto preamp protection" ToolTip="Reduce pre-gain when EQ boosts could cause clipping. A manual pre-gain adjustment turns protection off."/></Border><Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"><CheckBox Content="Show individual curves" IsChecked="{Binding IndividualCurves, Mode=TwoWay}" Style="{StaticResource SwitchStyle}" AutomationProperties.Name="Show individual curves" ToolTip="Display individual filter responses."/></Border><Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,0"><CheckBox Content="Show target curve" IsChecked="{Binding ShowReferenceCurve, Mode=TwoWay}" Style="{StaticResource SwitchStyle}" AutomationProperties.Name="Show target curve" ToolTip="Display your selected EQ tuning target."/></Border></StackPanel></Border><Border Style="{StaticResource CardBorderStyle}" Background="{DynamicResource LayerFillColorDefaultBrush}" Margin="0,0,12,12" Padding="18,12"><StackPanel><TextBlock Text="Advanced" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,8"/><Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"><CheckBox Content="Debug logging" IsChecked="{Binding DebugLogging, Mode=TwoWay}" Style="{StaticResource SwitchStyle}" AutomationProperties.Name="Debug logging" ToolTip="Record detailed diagnostic events."/></Border><Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,0"><CheckBox Content="Auto refresh on connect" IsChecked="{Binding AutoRefreshOnConnect, Mode=TwoWay}" Style="{StaticResource SwitchStyle}" AutomationProperties.Name="Auto refresh on connect" ToolTip="Read device values after connecting. Your unapplied edits are kept."/></Border><WrapPanel Margin="0,10,0,0"><Button Content="Diagnostics" Command="{Binding ShowDiagnosticsCommand}" Margin="0,0,6,5"/><Button Content="Open logs" Command="{Binding OpenLogsCommand}" Margin="0,0,6,5"/><Button Content="Export logs" Command="{Binding ExportLogsCommand}" Margin="0,0,0,5"/></WrapPanel></StackPanel></Border></UniformGrid>
       <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,4,12,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Moondrop" FontWeight="SemiBold"/><TextBlock Text="{Binding AppVersion}" Style="{StaticResource CaptionTextStyle}" Margin="0,3,12,0"/></StackPanel><WrapPanel Grid.Column="1"><Button Content="GitHub" Command="{Binding OpenGitHubCommand}" Margin="0,0,8,0"/><Button Content="Check for updates" Command="{Binding CheckUpdatesCommand}" ToolTip="Open available releases on GitHub. Updates are not installed automatically."/></WrapPanel></Grid></Border>
      </StackPanel></Border>
