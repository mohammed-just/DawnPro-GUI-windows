<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Dark theme tokens. Dark surfaces, light ink: buttons never use a near-white background
       with white text; enabled vs disabled are clearly distinct. -->

  <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#2B2B2B"/>
  <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#3A3A3A"/>
  <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#4A4A4A"/>
  <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#3B3B3B"/>
  <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#4A4A4A"/>
  <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#505050"/>
  <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#F2F2F2"/>
  <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#B8B8B8"/>
  <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#4FA6E0"/>
  <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#E56A5A"/>

  <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#3D3D3D"/>
  <SolidColorBrush x:Key="ButtonForegroundBrush" Color="#F2F2F2"/>
  <SolidColorBrush x:Key="ButtonBorderBrush" Color="#5A5A5A"/>
  <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="#4A4A4A"/>
  <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="#565656"/>
  <SolidColorBrush x:Key="ButtonFocusBorderBrush" Color="#7CB8E8"/>
  <SolidColorBrush x:Key="DisabledButtonBackgroundBrush" Color="#2E2E2E"/>
  <SolidColorBrush x:Key="DisabledButtonForegroundBrush" Color="#8A8A8A"/>
  <SolidColorBrush x:Key="DisabledButtonBorderBrush" Color="#3A3A3A"/>
</ResourceDictionary>