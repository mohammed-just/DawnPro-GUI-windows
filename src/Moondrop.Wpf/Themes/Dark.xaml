<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Dark theme tokens. Dark surfaces, light ink: buttons never use a near-white background
       with white text; enabled vs disabled are clearly distinct. -->
  <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#101317"/>
  <SolidColorBrush x:Key="ControlSolidFillColorDefaultBrush" Color="#202730"/>

  <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#13171C"/>
  <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#191E25"/>
  <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#2A323C"/>
  <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#202730"/>
  <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#2A323C"/>
  <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#35414E"/>
  <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#EEF2F6"/>
  <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#A6B2C0"/>
  <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#67D2FB"/>
  <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#E56A5A"/>

  <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#202730"/>
  <SolidColorBrush x:Key="ButtonForegroundBrush" Color="#EEF2F6"/>
  <SolidColorBrush x:Key="ButtonBorderBrush" Color="#35414E"/>
  <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="#2A323C"/>
  <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="#303C49"/>
  <SolidColorBrush x:Key="ButtonFocusBorderBrush" Color="#67D2FB"/>
  <SolidColorBrush x:Key="DisabledButtonBackgroundBrush" Color="#171C22"/>
  <SolidColorBrush x:Key="DisabledButtonForegroundBrush" Color="#738191"/>
  <SolidColorBrush x:Key="DisabledButtonBorderBrush" Color="#191E25"/>
  <SolidColorBrush x:Key="AccentSurfaceBrush" Color="#162D38"/>
  <SolidColorBrush x:Key="AccentTextBrush" Color="#102330"/>
  <SolidColorBrush x:Key="SuccessBrush" Color="#88D7BC"/>
  <SolidColorBrush x:Key="TargetBrush" Color="#C8ABF5"/>
</ResourceDictionary>
