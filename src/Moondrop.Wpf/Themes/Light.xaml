<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Light theme tokens. These shadow no framework resources incorrectly: they are provided
       per theme by WpfTheme.Apply so the whole shell has one coherent, legible palette. -->

  <!-- Fluent-style surface/ink tokens -->
  <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#FAFAFA"/>
  <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#DDDDDD"/>
  <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#F0F0F0"/>
  <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#E0E0E0"/>
  <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#D4D4D4"/>
  <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#171717"/>
  <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#5C5C5C"/>
  <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#0F6CBD"/>
  <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#C42B1C"/>

  <!-- Semantic button tokens -->
  <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#F3F3F3"/>
  <SolidColorBrush x:Key="ButtonForegroundBrush" Color="#171717"/>
  <SolidColorBrush x:Key="ButtonBorderBrush" Color="#BEBEBE"/>
  <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="#E1E1E1"/>
  <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="#D5D5D5"/>
  <SolidColorBrush x:Key="ButtonFocusBorderBrush" Color="#0F6CBD"/>
  <SolidColorBrush x:Key="DisabledButtonBackgroundBrush" Color="#F5F5F5"/>
  <SolidColorBrush x:Key="DisabledButtonForegroundBrush" Color="#9C9C9C"/>
  <SolidColorBrush x:Key="DisabledButtonBorderBrush" Color="#E4E4E4"/>
</ResourceDictionary>