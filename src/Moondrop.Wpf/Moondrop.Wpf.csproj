<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\device-logo.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\device-logo.ico" />
    <Resource Include="Assets\device-logo.png" />
    <ProjectReference Include="..\Moondrop.Core\Moondrop.Core.csproj" />
    <ProjectReference Include="..\Moondrop.Hardware\Moondrop.Hardware.csproj" />
  </ItemGroup>

</Project>
